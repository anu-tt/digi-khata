rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health-check / connection probe
    match /test/connection {
      allow get: if true;
    }

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isVerifiedLegacyOwner(userId) {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             userId.matches('^usr_[a-zA-Z0-9_]+$') &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User document validation
    function isValidUserProfile(data) {
      return data.keys().hasOnly(['id', 'name', 'email', 'businessName', 'address', 'avatar', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 100)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
             (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 128)) &&
             (!('pinSalt' in data) || (data.pinSalt is string && data.pinSalt.size() <= 64)) &&
             (!('isBiometricEnabled' in data) || data.isBiometricEnabled is bool);
    }

    function isValidEncryptedVault(data, userId) {
      return data.keys().hasOnly(['userId', 'ciphertext', 'iv', 'salt', 'version', 'updatedAt']) &&
             data.userId == userId &&
             data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 1000000 &&
             data.iv is string && data.iv.size() <= 64 &&
             data.salt is string && data.salt.size() <= 64 &&
             data.version == 1 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidVaultManifest(data, userId) {
      return data.keys().hasOnly(['userId', 'generation', 'chunksCount', 'iv', 'salt', 'version', 'updatedAt']) &&
             data.userId == userId &&
             data.generation is string && data.generation.matches('^[a-zA-Z0-9]{32}$') &&
             data.chunksCount is int && data.chunksCount > 0 && data.chunksCount <= 500 &&
             data.iv is string && data.iv.size() <= 64 &&
             data.salt is string && data.salt.size() <= 64 &&
             data.version == 1 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidVaultChunk(data, userId) {
      return data.keys().hasOnly(['userId', 'generation', 'index', 'ciphertext']) &&
             data.userId == userId &&
             data.generation is string && data.generation.matches('^[a-zA-Z0-9]{32}$') &&
             data.index is int && data.index >= 0 && data.index < 500 &&
             data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 700000;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || (request.auth != null && request.auth.token.email_verified == true &&
        userId.matches('^usr_[a-zA-Z0-9_]+$') && (resource == null || resource.data.email == request.auth.token.email));
      allow list: if request.auth != null && request.auth.token.email_verified == true &&
        resource.data.email == request.auth.token.email;
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId) || isVerifiedLegacyOwner(userId);

      // Parties Subcollection
      match /parties/{partyId} {
        allow get, list: if isOwner(userId) || isVerifiedLegacyOwner(userId);
        allow delete: if (isOwner(userId) || isVerifiedLegacyOwner(userId)) && isValidId(partyId);
      }

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isVerifiedLegacyOwner(userId);
        allow delete: if (isOwner(userId) || isVerifiedLegacyOwner(userId)) && isValidId(transactionId);
      }

      // Vault / backup subcollection
      match /vault/{vaultId} {
        allow get, list: if isOwner(userId) || isVerifiedLegacyOwner(userId);
        allow create, update: if isOwner(userId) && (
          (vaultId == 'encrypted' && (isValidVaultManifest(request.resource.data, userId) || isValidEncryptedVault(request.resource.data, userId))) ||
          (vaultId.matches('^chunk_[a-zA-Z0-9]{32}_[0-9]{1,3}$') && isValidVaultChunk(request.resource.data, userId))
        );
        allow delete: if (isOwner(userId) || isVerifiedLegacyOwner(userId)) &&
          (vaultId == 'encrypted' || vaultId.matches('^chunk_[a-zA-Z0-9]{32}_[0-9]{1,3}$'));
      }
    }
  }
}
